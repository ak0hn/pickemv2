# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# session/project context — local only, never GitHub (may reference personal
# Jira/Notion links). See CLAUDE/CONTEXT.md "Tools by Purpose".
PROJECT_CONTEXT.md

# typescript
*.tsbuildinfo
next-env.d.ts
